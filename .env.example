# ==============================================================================
# OmniRAG — Enterprise Environment Configuration
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="OmniRAG Knowledge Intelligence Platform"
API_V1_PREFIX=/api/v1
SECRET_KEY=change-this-in-production-to-a-64-character-random-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Database (PostgreSQL 16)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=omnirag_admin
POSTGRES_PASSWORD=omnirag_secure_password
POSTGRES_DB=omnirag
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10

# Redis (Caching, Sessions & Celery Broker)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Vector Store (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=omnirag_chunks
QDRANT_VECTOR_DIMENSION=1536
QDRANT_DISTANCE_METRIC=Cosine

# Object Storage (S3 / MinIO)
STORAGE_BACKEND=local # local | s3 | minio
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=omnirag-documents
S3_REGION=us-east-1
LOCAL_STORAGE_DIR=./data/storage

# Model Providers
DEFAULT_LLM_PROVIDER=openai # openai | anthropic | gemini | local
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEFAULT_EMBEDDING_PROVIDER=openai
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Reranker Configuration
RERANKER_MODEL=bge-reranker-large
RERANKER_TOP_K=10
RERANKER_SCORE_THRESHOLD=0.35

# Agentic Search Bounds
AGENT_MAX_STEPS=5
AGENT_MAX_TOOL_CALLS=8
AGENT_TIMEOUT_SECONDS=25
AGENT_TOKEN_BUDGET=16000

# Google OAuth 2.0 Authentication
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_METRICS_ENABLED=true
LOG_LEVEL=INFO

